{
  "name": "log-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minimalist offline PWA for searching WhatsApp-style chat logs by speaker, date and keyword.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/render-icons.mjs",
    "verify": "node scripts/verify-boot.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "sharp": "^0.34.0"
  }
}
